periods 40; // 1900 to 2095

@#define NLS=21  
var Ptot;

@#for i in 1:NLS
var P_@{i};
@#endfor 

@#for i in 2:NLS
var beta_@{i};
@#endfor 

@#for i in 2:NLS
var h_@{i};
@#endfor 

varexo xpop h_1;

@#for i in 1:NLS
varexo mig_@{i};
@#endfor 

%@#for i in 2:NLS
%varexo beta_@{i};
%@#endfor 

@#for i in 2:NLS
varexo med_@{i};
@#endfor 

parameters deltah;
deltah=0.04;


model;

P_1 = xpop + mig_1;       // Population 0-4 ans                 

@#for i in 2:NLS
P_@{i}=beta_@{i}(-1)*P_@{i-1}(-1) + mig_@{i};
@#endfor 
 
Ptot= (
@#for i in 1:NLS
+ P_@{i}
@#endfor
);

@#for i in 2:NLS
h_@{i} =  (1-deltah)*h_@{i-1}(-1) + med_@{i};
h_@{i}*beta_@{i} = h_@{i}-1;
@#endfor

end;

initval;

@#for i in 1:NLS
h_@{i} =  120;
@#endfor

